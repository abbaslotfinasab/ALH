---
import { navigation, profile } from "../data/profile";
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div>
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">AL</span>
          <span class="brand-copy">
            <strong>{profile.name}</strong>
            <small>{profile.role}</small>
          </span>
        </a>
        <p class="footer-intro">{profile.shortBio}</p>
      </div>

      <div>
        <h2 class="footer-title">دسترسی سریع</h2>
        <nav class="footer-links" aria-label="پیوندهای فوتر">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/contact/">ارتباط</a>
        </nav>
      </div>

      <div>
        <h2 class="footer-title">ارتباط حرفه‌ای</h2>
        <div class="footer-links">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.website} target="_blank" rel="noreferrer">وب‌سایت شخصی</a>
          <a href="https://github.com/abbaslotfinasab" target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {profile.latinName}. تمام حقوق محفوظ است.</span>
      <span>Designed around systems, built for impact.</span>
    </div>
  </div>
</footer>
