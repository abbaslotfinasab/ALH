---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.status === "published");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const title = project.data.seoTitle ?? project.data.title;
const description = project.data.seoDescription ?? project.data.summary;
const canonicalPath = project.data.canonicalPath ?? `/projects/${project.id}/`;
---
<MainLayout title={title} description={description} canonicalPath={canonicalPath}>
  <article class="container content-panel editorial-page">
    <a class="text-link" href="/experience/">بازگشت به تجربه‌ها</a>
    <header class="page-hero">
      <span class="eyebrow">{project.data.category ?? "SELECTED PROJECT"}</span>
      <h1>{project.data.title}</h1>
      <p>{project.data.summary}</p>
      {project.data.role && <p>نقش: {project.data.role}</p>}
      {project.data.technologies.length > 0 && (
        <p>فناوری‌ها: {project.data.technologies.join("، ")}</p>
      )}
    </header>
    <div class="editorial-content"><Content /></div>
  </article>
</MainLayout>
