---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const insights = await getCollection("insights", ({ data }) => data.status === "published");
  return insights.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = entry.data.seoTitle ?? entry.data.title;
const description = entry.data.seoDescription ?? entry.data.summary;
const canonicalPath = entry.data.canonicalPath ?? `/insights/${entry.id}/`;
---
<MainLayout title={title} description={description} canonicalPath={canonicalPath}>
  <article class="container content-panel editorial-page">
    <a class="text-link" href="/insights/">بازگشت به یادداشت‌ها</a>
    <header class="page-hero">
      <span class="eyebrow">{entry.data.category ?? "INSIGHTS & NOTES"}</span>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      {entry.data.publishedAt && <time datetime={entry.data.publishedAt.toISOString()}>{entry.data.publishedAt.toLocaleDateString("fa-IR")}</time>}
      {entry.data.readingMinutes && <span> · {entry.data.readingMinutes} دقیقه مطالعه</span>}
    </header>
    <div class="editorial-content"><Content /></div>
  </article>
</MainLayout>
