---
import MainLayout from "../layouts/MainLayout.astro";
import { profile } from "../data/profile";
import { ventures } from "../data/ventures";

const problems = [
  { number: "01", title: "اطلاعات پراکنده", description: "وقتی سفارش‌ها، هزینه‌ها و اطلاعات مشتریان در چند دفتر و فایل جدا هستند، دیدن تصویر کامل کسب‌وکار سخت می‌شود." },
  { number: "02", title: "کارهای تکراری و وقت‌گیر", description: "ثبت چندباره اطلاعات و پیگیری دستی کارها، وقت شما و تیمتان را از رسیدگی به مشتری می‌گیرد." },
  { number: "03", title: "تصمیم‌گیری با حدس و گمان", description: "وقتی عددها و گزارش‌های قابل اعتماد در دسترس نباشند، کنترل هزینه و برنامه‌ریزی برای رشد دشوار می‌شود." },
];
const audiences = [
  { id: "restaurants", title: "رستوران‌ها و کافه‌ها", description: "برای نظم دادن به سفارش‌ها، مواد اولیه، خرید، انبار و هزینه‌های هر غذا.", label: "راهکارهای مدیریت رستوران", href: "/ventures/#restaurants" },
  { id: "gyms", title: "باشگاه‌های ورزشی", description: "برای شناخت بهتر فرایندهای باشگاه و طراحی ابزارهایی متناسب با کار روزانه مجموعه.", label: "راهکارهای باشگاه ورزشی", href: "/ventures/#gyms" },
  { id: "businesses", title: "سایر کسب‌وکارها", description: "برای ساده‌سازی فرایندها و ساخت ابزارهایی که با نیاز کسب‌وکار شما هماهنگ باشند.", label: "راهکار اختصاصی", href: "/ventures/#businesses" },
];
const steps = [
  { number: "۱", title: "اول کسب‌وکار را می‌شناسیم", description: "با شما درباره شیوه فعلی کار، چالش‌ها و هدفی که می‌خواهید به آن برسید صحبت می‌کنیم." },
  { number: "۲", title: "راه مناسب را پیدا می‌کنیم", description: "مشخص می‌کنیم چه چیزی را می‌توان ساده‌تر کرد و کجا واقعاً به نرم‌افزار نیاز دارید." },
  { number: "۳", title: "راهکار را می‌سازیم", description: "راهکار را مرحله‌به‌مرحله توسعه می‌دهیم و در مسیر، با نیاز واقعی شما تطبیق می‌دهیم." },
];
---
<MainLayout title="راهکارهای دیجیتال برای مدیریت بهتر کسب‌وکار" description="به صاحبان رستوران‌ها، کافه‌ها، باشگاه‌های ورزشی و کسب‌وکارهای خدماتی کمک می‌کنم کارهای روزمره را ساده‌تر و مدیریت را دقیق‌تر کنند.">
  <section class="hero business-hero">
    <div class="container business-hero-grid">
      <div class="hero-content">
        <span class="eyebrow">راهکارهای دیجیتال برای کسب‌وکارها</span>
        <h1 class="hero-title">کسب‌وکارت رو <em>منظم‌تر مدیریت کن</em>؛ برای رشد آماده‌تر باش.</h1>
        <p class="hero-description">به صاحبان رستوران‌ها، کافه‌ها، باشگاه‌های ورزشی و کسب‌وکارهای خدماتی کمک می‌کنم کارهای روزمره را ساده‌تر کنند، هزینه‌ها را بهتر بشناسند و با اطلاعات روشن‌تر تصمیم بگیرند.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="/ventures/">دیدن راهکارها <span aria-hidden="true">↗</span></a>
          <a class="button button--secondary" href="/contact/">درباره کسب‌وکارت صحبت کنیم</a>
        </div>
        <div class="business-hero-note"><span class="business-hero-note-mark" aria-hidden="true">✓</span><span>راهکار باید با شیوه واقعی کار شما جور باشد؛ نه برعکس.</span></div>
      </div>
      <div class="business-hero-visual" aria-label="نمایی از بخش‌های مختلف یک کسب‌وکار که در کنار هم کار می‌کنند">
        <div class="business-visual-top"><span>مدیریت یکپارچه</span><span>BUSINESS OVERVIEW</span></div>
        <div class="business-visual-center"><span class="business-visual-center-icon">✳</span><strong>کسب‌وکار شما</strong><small>همه‌چیز، در یک مسیر روشن‌تر</small></div>
        <div class="business-visual-node business-visual-node--one"><span>▦</span><strong>سفارش‌ها</strong></div>
        <div class="business-visual-node business-visual-node--two"><span>◫</span><strong>موجودی و خرید</strong></div>
        <div class="business-visual-node business-visual-node--three"><span>◷</span><strong>گزارش و هزینه</strong></div>
        <div class="business-visual-node business-visual-node--four"><span>◎</span><strong>مشتریان</strong></div>
        <div class="business-visual-foot"><span>اطلاعات منظم‌تر</span><span>تصمیم‌های بهتر</span></div>
      </div>
    </div>
  </section>

  <section class="proof-strip business-proof"><div class="container proof-strip-grid">
    <div><strong>از مسئله واقعی</strong><span>شروع از نیاز و شیوه کار شما</span></div>
    <div><strong>راهکار متناسب</strong><span>نه نرم‌افزارهای شلوغ و غیرضروری</span></div>
    <div><strong>همراه تا اجرا</strong><span>از شناخت نیاز تا ساخت و بهبود</span></div>
  </div></section>

  <section class="section"><div class="container">
    <div class="section-intro"><div><span class="eyebrow">چالش‌های روزمره</span><h2 class="section-heading">بعضی دردسرها، نباید بخشی از کار هر روز باشند.</h2></div><p class="section-copy">بسیاری از کسب‌وکارها با بزرگ‌تر شدن، با اطلاعات پراکنده و کارهای دستی بیشتری روبه‌رو می‌شوند. راه‌حل از شناخت همین جزئیات شروع می‌شود.</p></div>
    <div class="business-problem-grid">{problems.map((item) => <article class="business-problem-card"><span>{item.number}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
  </div></section>

  <section class="section section--tinted"><div class="container">
    <div class="section-intro"><div><span class="eyebrow">برای چه کسب‌وکارهایی؟</span><h2 class="section-heading">هر صنف، مسئله‌ها و راهکارهای خودش را دارد.</h2></div><p class="section-copy">به‌جای یک نسخه یکسان برای همه، از نیازهای هر حوزه شروع می‌کنیم و راهکار مناسب همان کسب‌وکار را طراحی می‌کنیم.</p></div>
    <div class="business-audience-grid">{audiences.map((item) => <a class="business-audience-card" href={item.href}><span class="business-audience-icon" aria-hidden="true">{item.id === "restaurants" ? "♨" : item.id === "gyms" ? "↗" : "◈"}</span><h3>{item.title}</h3><p>{item.description}</p><span class="business-audience-link">{item.label} <b aria-hidden="true">←</b></span></a>)}</div>
  </div></section>

  <section class="section"><div class="container business-product-feature">
    <div class="business-product-copy"><span class="eyebrow">محصول در حال توسعه</span><p class="venture-kicker">{ventures[0].category}</p><h2>{ventures[0].name}</h2><p>{ventures[0].description}</p><ul class="business-check-list">{ventures[0].focus.map((item) => <li>{item}</li>)}</ul><a class="button button--primary" href="/ventures/#products">آشنایی بیشتر با محصولات <span aria-hidden="true">↗</span></a></div>
    <div class="business-product-visual" aria-hidden="true"><div class="product-window"><div class="product-window-bar"><i></i><i></i><i></i><span>نمای کلی کسب‌وکار</span></div><div class="product-window-body"><div class="product-stat"><small>موجودی</small><b>مواد اولیه</b><span>کنترل دقیق‌تر</span></div><div class="product-stat"><small>خرید</small><b>تأمین‌کنندگان</b><span>پیگیری ساده‌تر</span></div><div class="product-stat"><small>منو</small><b>دستور پخت</b><span>شناخت هزینه‌ها</span></div><div class="product-window-chart"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div></div></div><span class="product-visual-caption">EATHUB · HOSPITALITY MANAGEMENT</span></div>
  </div></section>

  <section class="section section--tinted"><div class="container">
    <div class="section-intro"><div><span class="eyebrow">مسیر همکاری</span><h2 class="section-heading">قرار نیست از روز اول همه‌چیز را عوض کنیم.</h2></div><p class="section-copy">قدم‌به‌قدم جلو می‌رویم؛ اول مسئله را درست می‌فهمیم، بعد برای همان مسئله راهکار می‌سازیم.</p></div>
    <div class="business-steps-grid">{steps.map((step) => <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
  </div></section>

  <section class="section section--compact"><div class="container business-about-panel"><div><span class="eyebrow">درباره من</span><h2>من عباس لطفی‌نسب هستم؛ از دنیای نرم‌افزار تا مسئله‌های واقعی کسب‌وکار.</h2></div><div><p>{profile.shortBio}</p><a class="text-link" href="/about/">بیشتر درباره مسیر من <span>←</span></a></div></div></section>
  <section class="section--compact"><div class="container contact-panel"><div><span class="eyebrow">شروع یک گفت‌وگوی ساده</span><h2>بگو کجای کار، وقت یا انرژی‌ات هدر می‌رود.</h2><p>با هم بررسی می‌کنیم آیا می‌شود آن بخش را ساده‌تر، دقیق‌تر یا خودکار کرد.</p></div><a class="button button--primary" href="/contact/">درباره کسب‌وکارت صحبت کنیم <span aria-hidden="true">↗</span></a></div></section>
</MainLayout>
