---
import MainLayout from "../layouts/MainLayout.astro";
import { profile } from "../data/profile";
import { principles } from "../data/principles";
---
<MainLayout title="درباره من" description="عباس لطفی‌نسب؛ مهندس نرم‌افزار و سازنده محصولات دیجیتال. تمرکز بر حل مسئله‌های واقعی کسب‌وکار با کمک نرم‌افزار، اتوماسیون و فناوری.">
  <section class="page-hero"><div class="container"><span class="eyebrow">درباره عباس</span><h1>فناوری وقتی ارزش دارد که کار را برای آدم‌ها ساده‌تر کند.</h1><p>{profile.shortBio}</p></div></section>
  <section class="container about-content">
    <div class="about-lead surface"><span class="eyebrow">مسیر من</span><h2>از توسعه اپلیکیشن تا ساخت محصول برای مسئله‌های واقعی.</h2><p>مسیر حرفه‌ای من از سال ۱۳۹۷ و با توسعه اپلیکیشن‌های اندروید آغاز شد. بعد از آن، تجربه‌ام را در توسعه وب و ساخت محصولات نرم‌افزاری گسترش دادم. در این مسیر، علاوه بر ساخت بخش‌های فنی، بیشتر به این موضوع علاقه‌مند شدم که نرم‌افزار چطور می‌تواند بخشی از کار روزانه یک کسب‌وکار را بهتر کند.</p><p>تحصیلاتم در مهندسی نرم‌افزار و تجربه کار روی محصولات موبایل و وب، پایه‌ای فنی برای این نگاه ساخته‌اند. امروز تلاش می‌کنم قبل از پیشنهاد فناوری، مسئله و شیوه واقعی کار افراد را بشناسم.</p></div>
    <aside class="about-facts surface"><span class="eyebrow">خلاصه</span><dl><div><dt>حوزه فعالیت</dt><dd>ساخت محصولات و راهکارهای دیجیتال</dd></div><div><dt>نقش</dt><dd>بنیان‌گذار و سازنده محصول</dd></div><div><dt>شروع مسیر</dt><dd>۱۳۹۷</dd></div><div><dt>تحصیلات</dt><dd>کارشناسی مهندسی نرم‌افزار</dd></div><div><dt>تمرکز فعلی</dt><dd>راهکارهای مدیریت کسب‌وکار</dd></div></dl></aside>
  </section>
  <section class="section section--tinted"><div class="container"><div class="section-intro"><div><span class="eyebrow">نگاه من به کار</span><h2 class="section-heading">چطور به یک مسئله نگاه می‌کنم؟</h2></div><p class="section-copy">قبل از اینکه سراغ ساخت نرم‌افزار برویم، باید مطمئن شویم مسئله را درست فهمیده‌ایم و راه‌حل پیشنهادی واقعاً به کار می‌آید.</p></div><div class="about-focus-grid"><article><span>۰۱</span><h3>اول شنیدن و شناختن</h3><p>با مدیران و افرادی که هر روز با فرایندها سروکار دارند صحبت می‌کنم تا مسئله از نزدیک دیده شود.</p></article><article><span>۰۲</span><h3>ساده‌سازی قبل از پیچیده‌سازی</h3><p>هر مشکلی به نرم‌افزار جدید نیاز ندارد. گاهی اصلاح یک فرایند، بهترین راه‌حل است.</p></article><article><span>۰۳</span><h3>ساخت برای استفاده واقعی</h3><p>راهکار باید قابل استفاده، قابل اعتماد و متناسب با شرایط واقعی کسب‌وکار باشد.</p></article></div></div></section>
  <section class="section"><div class="container"><span class="eyebrow">اصول کاری</span><h2 class="section-heading">چند اصل که در تصمیم‌هایم ثابت می‌مانند.</h2><div class="principles-grid">{principles.map((item) => <article class="principle-card"><span class="principle-number">{item.number}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div></section>
</MainLayout>
